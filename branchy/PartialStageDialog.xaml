<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Branchy.PartialStageDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Branchy.Converters"
    xmlns:models="using:Branchy.Models"
    xmlns:viewModels="using:Branchy.ViewModels"
    x:Uid="PartialStageDialog"
    CornerRadius="8"
    DefaultButton="None">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1020</x:Double>
        <converters:DiffLineKindToVisibilityConverter x:Key="PartialDiffLineKindToVisibilityConverter" />
    </ContentDialog.Resources>

    <Grid Width="940" Height="520" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <InfoBar
            x:Uid="PartialStageErrorInfoBar"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.Path}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" />
            </StackPanel>
            <Button
                x:Uid="SelectAllHunksButton"
                Grid.Column="1"
                Click="SelectAllHunksButton_Click" />
            <Button
                x:Uid="ClearHunkSelectionButton"
                Grid.Column="2"
                Click="ClearHunkSelectionButton_Click" />
        </Grid>

        <Border
            Grid.Row="2"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <ListView
                    HorizontalContentAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.Hunks}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:PartialStageHunkItem">
                            <Border
                                Margin="4"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <CheckBox
                                        Margin="10,7"
                                        Content="{x:Bind Summary}"
                                        FontFamily="Cascadia Mono, Consolas"
                                        IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                    <ItemsRepeater Grid.Row="1" ItemsSource="{x:Bind Lines}">
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="models:GitDiffLine">
                                                <Grid>
                                                    <Border
                                                        Padding="10,2"
                                                        Background="Transparent"
                                                        Visibility="{x:Bind Kind, Converter={StaticResource PartialDiffLineKindToVisibilityConverter}, ConverterParameter=Context}">
                                                        <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12" IsTextSelectionEnabled="True" Text="{x:Bind Text}" />
                                                    </Border>
                                                    <Border
                                                        Padding="10,2"
                                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                        Visibility="{x:Bind Kind, Converter={StaticResource PartialDiffLineKindToVisibilityConverter}, ConverterParameter=Addition}">
                                                        <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" IsTextSelectionEnabled="True" Text="{x:Bind Text}" />
                                                    </Border>
                                                    <Border
                                                        Padding="10,2"
                                                        Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                                        Visibility="{x:Bind Kind, Converter={StaticResource PartialDiffLineKindToVisibilityConverter}, ConverterParameter=Deletion}">
                                                        <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" IsTextSelectionEnabled="True" Text="{x:Bind Text}" />
                                                    </Border>
                                                    <Border
                                                        Padding="10,2"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        Visibility="{x:Bind Kind, Converter={StaticResource PartialDiffLineKindToVisibilityConverter}, ConverterParameter=HunkHeader}">
                                                        <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" IsTextSelectionEnabled="True" Text="{x:Bind Text}" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    x:Uid="PartialStageEmptyText"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasNoHunks, Mode=OneWay}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
            <ProgressRing
                Width="16"
                Height="16"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
        </StackPanel>

        <StackPanel
            Grid.Row="4"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Uid="ApplySelectedHunksButton"
                MinWidth="168"
                Click="ApplySelectedHunksButton_Click"
                IsEnabled="{x:Bind ViewModel.CanApply, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                x:Uid="ClosePartialStageButton"
                MinWidth="120"
                Click="ClosePartialStageButton_Click" />
        </StackPanel>
    </Grid>
</ContentDialog>
