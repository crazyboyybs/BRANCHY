<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Branchy.QuickEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Uid="QuickEditDialog" CornerRadius="8" DefaultButton="None" Closing="Dialog_Closing">
    <ContentDialog.Resources><x:Double x:Key="ContentDialogMaxWidth">1120</x:Double></ContentDialog.Resources>
    <Grid x:Name="EditorLayout" RowSpacing="12" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="Find_Invoked" />
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="Save_Invoked" />
            <KeyboardAccelerator Key="F3" Invoked="Next_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock x:Name="FilePathText" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Uid="QuickEditNotice" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <InfoBar x:Name="ErrorInfo" Grid.Row="1" IsOpen="False" Severity="Error" />
        <AutoSuggestBox x:Name="SearchBox" x:Uid="DiffSearchBox" Grid.Row="2" Visibility="Collapsed" QueryIcon="Find" QuerySubmitted="Search_Submitted" />
        <TextBox x:Name="Editor" Grid.Row="3" AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas" FontSize="13"
            IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" TextWrapping="NoWrap"
            ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="Editor_TextChanged" />
        <StackPanel Grid.Row="4" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
            <Button x:Name="SaveButton" x:Uid="QuickEditSaveButton" Style="{StaticResource AccentButtonStyle}" CornerRadius="4" Click="Save_Click" IsEnabled="False" />
            <Button x:Name="CancelButton" x:Uid="CancelOperationButton" CornerRadius="4" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</ContentDialog>
