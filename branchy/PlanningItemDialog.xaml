<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Branchy.PlanningItemDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Branchy"
    CornerRadius="8"
    DefaultButton="None">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
    </ContentDialog.Resources>

    <Grid
        Width="680"
        Height="640"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0" Spacing="14">
            <InfoBar
                x:Name="ValidationInfoBar"
                x:Uid="PlanningItemValidationInfoBar"
                IsClosable="False"
                IsOpen="False"
                Severity="Warning" />

            <TextBox
                x:Name="TitleTextBox"
                x:Uid="PlanningItemTitleTextBox"
                MaxLength="120"
                TextChanged="TitleTextBox_TextChanged" />

            <TextBox
                x:Name="DescriptionTextBox"
                x:Uid="PlanningItemDescriptionTextBox"
                AcceptsReturn="True"
                MaxLength="600"
                MinHeight="88"
                TextWrapping="Wrap" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    x:Name="TypeComboBox"
                    x:Uid="PlanningItemTypeComboBox"
                    DisplayMemberPath="Label"
                    HorizontalAlignment="Stretch" />
                <ComboBox
                    x:Name="StatusComboBox"
                    x:Uid="PlanningItemStatusComboBox"
                    Grid.Column="1"
                    DisplayMemberPath="Label"
                    HorizontalAlignment="Stretch" />
            </Grid>

            <StackPanel Spacing="6">
                <Grid>
                    <TextBlock
                        x:Uid="PlanningItemProgressLabel"
                        FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="ProgressValueText"
                        HorizontalAlignment="Right"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Grid>
                <Slider
                    x:Name="ProgressSlider"
                    Margin="10,0"
                    Minimum="0"
                    Maximum="100"
                    StepFrequency="5"
                    ValueChanged="ProgressSlider_ValueChanged" />
            </StackPanel>

            <TextBox
                x:Name="TagsTextBox"
                x:Uid="PlanningItemTagsTextBox" />

            <ComboBox
                x:Name="CommitComboBox"
                x:Uid="PlanningItemCommitComboBox"
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind CommitOptions}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="local:PlanningCommitOption">
                        <StackPanel MaxWidth="600" Spacing="2">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{x:Bind PrimaryText}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind SecondaryText}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind HasSecondaryText}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBox
                x:Name="DocumentationTextBox"
                x:Uid="PlanningItemDocumentationTextBox"
                AcceptsReturn="True"
                MinHeight="180"
                TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <Grid
            Grid.Row="1"
            Margin="0,0,12,0"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="SaveButton"
                HorizontalAlignment="Stretch"
                Click="SaveButton_Click"
                CornerRadius="{ThemeResource ControlCornerRadius}"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                x:Name="CancelButton"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Click="CancelButton_Click"
                CornerRadius="{ThemeResource ControlCornerRadius}" />
        </Grid>
    </Grid>
</ContentDialog>
