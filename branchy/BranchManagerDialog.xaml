<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Branchy.BranchManagerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Branchy.Models"
    x:Uid="BranchManagerDialog"
    CornerRadius="8"
    DefaultButton="None">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">820</x:Double>
    </ContentDialog.Resources>

    <Grid Width="760" MinHeight="440" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <InfoBar
            x:Uid="BranchErrorInfoBar"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <ListView
                    ItemsSource="{x:Bind ViewModel.Branches}"
                    SelectedItem="{x:Bind ViewModel.SelectedBranch, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:GitBranch">
                            <Grid Padding="10,7" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    FontSize="14"
                                    Glyph="&#xE73E;"
                                    Visibility="{x:Bind IsCurrent}" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Upstream}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{x:Bind HasUpstream}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <StackPanel Grid.Column="1" Spacing="12">
                <TextBlock x:Uid="SelectedBranchTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBox
                    x:Uid="RenameBranchTextBox"
                    Text="{x:Bind ViewModel.RenamedBranchName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    x:Uid="RenameBranchButton"
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.RenameBranchCommand}" />
                <Button
                    x:Uid="SwitchBranchButton"
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.SwitchBranchCommand}"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    x:Uid="MergeBranchButton"
                    HorizontalAlignment="Stretch"
                    Click="MergeBranchButton_Click"
                    IsEnabled="{x:Bind ViewModel.CanMergeSelectedBranch, Mode=OneWay}" />
                <Button
                    x:Uid="DeleteBranchButton"
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.DeleteBranchCommand}" />
                <TextBlock
                    x:Uid="DeleteBranchHint"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Uid="NewBranchTextBox"
                    Text="{x:Bind ViewModel.NewBranchName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    x:Uid="CreateBranchButton"
                    Grid.Column="1"
                    Command="{x:Bind ViewModel.CreateBranchCommand}"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
            <ProgressRing
                Width="16"
                Height="16"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
        </StackPanel>

        <Button
            x:Uid="CloseBranchDialogButton"
            Grid.Row="4"
            MinWidth="120"
            HorizontalAlignment="Right"
            CornerRadius="4"
            Click="CloseBranchDialogButton_Click" />
    </Grid>
</ContentDialog>
