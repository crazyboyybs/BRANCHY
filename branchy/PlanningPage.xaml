<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Branchy.PlanningPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Branchy.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Branchy.Models"
    xmlns:viewModels="using:Branchy.ViewModels"
    Background="Transparent"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:PlanningItemTypeToBrushConverter x:Key="PlanningItemTypeToBrushConverter" />
        <Style x:Key="PlanningColumnListStyle" TargetType="ListView">
            <Setter Property="AllowDrop" Value="True" />
            <Setter Property="CanDragItems" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="IsItemClickEnabled" Value="False" />
            <Setter Property="Padding" Value="8,4,8,8" />
            <Setter Property="SelectionMode" Value="None" />
        </Style>
        <Style x:Key="PlanningCardListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <DataTemplate x:Key="PlanningCardTemplate" x:DataType="viewModels:PlanningCardViewModel">
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Border.Transitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="20" />
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </Border.Transitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Background="{x:Bind Type, Converter={StaticResource PlanningItemTypeToBrushConverter}}"
                        CornerRadius="8,0,0,8" />
                    <StackPanel Grid.Column="1" Padding="12,10" Spacing="9">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Text="{x:Bind Title}"
                                TextWrapping="WrapWholeWords" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                <Button
                                    x:Uid="PlanningEditCardButton"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Click="EditCardButton_Click"
                                    Tag="{x:Bind Id}">
                                    <SymbolIcon Symbol="Edit" />
                                </Button>
                                <Button
                                    x:Uid="PlanningDeleteCardButton"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Click="DeleteCardButton_Click"
                                    Tag="{x:Bind Id}">
                                    <SymbolIcon Symbol="Delete" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            MaxLines="3"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Description}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind HasDescription, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border
                                Padding="7,3"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="10">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Ellipse
                                        Width="7"
                                        Height="7"
                                        Fill="{x:Bind Type, Converter={StaticResource PlanningItemTypeToBrushConverter}}" />
                                    <TextBlock FontSize="11" Text="{x:Bind TypeLabel}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <ItemsControl ItemsSource="{x:Bind Tags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:PlanningTagViewModel">
                                    <Border
                                        Padding="7,2"
                                        Margin="0,0,5,5"
                                        Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                        CornerRadius="9">
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Text="{x:Bind Label}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border
                            Padding="8,6"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="5"
                            Visibility="{x:Bind HasLinkedCommit, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <SymbolIcon Symbol="Link" />
                                <TextBlock
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="11"
                                    Text="{x:Bind LinkedCommitSummary}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="5">
                            <Grid>
                                <TextBlock
                                    x:Uid="PlanningCardProgressLabel"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ProgressText}" />
                            </Grid>
                            <ProgressBar
                                Height="5"
                                Foreground="{x:Bind Type, Converter={StaticResource PlanningItemTypeToBrushConverter}}"
                                Maximum="100"
                                Value="{x:Bind Progress}" />
                        </StackPanel>

                        <Expander
                            Header="{x:Bind DocumentationHeader}"
                            Visibility="{x:Bind HasDocumentation, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock
                                Margin="0,6,0,2"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind Documentation}"
                                TextWrapping="Wrap" />
                        </Expander>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="20,14,20,16" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock x:Uid="PlanningPageTitle" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.RepositoryName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button
                x:Uid="PlanningNewItemActionButton"
                Grid.Column="1"
                Click="NewItemButton_Click"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <SymbolIcon Symbol="Add" />
                    <TextBlock x:Uid="PlanningNewItemButtonText" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Padding="10,6" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12">
                <TextBlock Text="{x:Bind ViewModel.TotalSummary, Mode=OneWay}" />
            </Border>
            <Border Grid.Column="1" Padding="10,6" Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="12">
                <TextBlock Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{x:Bind ViewModel.InProgressSummary, Mode=OneWay}" />
            </Border>
            <Border Grid.Column="2" Padding="10,6" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="12">
                <TextBlock Foreground="{ThemeResource SystemFillColorSuccessBrush}" Text="{x:Bind ViewModel.CompletedSummary, Mode=OneWay}" />
            </Border>
            <StackPanel Grid.Column="3" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <ProgressBar Width="120" VerticalAlignment="Center" Maximum="100" Value="{x:Bind ViewModel.AverageProgress, Mode=OneWay}" />
                <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.ProgressSummary, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox
                x:Name="SearchBox"
                x:Uid="PlanningSearchBox"
                QueryIcon="Find"
                TextChanged="SearchBox_TextChanged" />
            <ComboBox
                x:Name="TypeFilterComboBox"
                x:Uid="PlanningTypeFilterComboBox"
                Grid.Column="1"
                DisplayMemberPath="Label"
                ItemsSource="{x:Bind ViewModel.TypeFilters}"
                SelectedItem="{x:Bind ViewModel.SelectedTypeFilter, Mode=TwoWay}" />
            <ComboBox
                x:Name="TagFilterComboBox"
                x:Uid="PlanningTagFilterComboBox"
                Grid.Column="2"
                DisplayMemberPath="Label"
                ItemsSource="{x:Bind ViewModel.TagFilters}"
                SelectedItem="{x:Bind ViewModel.SelectedTagFilter, Mode=TwoWay}" />
        </Grid>

        <Grid Grid.Row="3">
            <InfoBar
                x:Uid="PlanningErrorInfoBar"
                Margin="0,0,0,8"
                VerticalAlignment="Top"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Closed="PlanningErrorInfoBar_Closed"
                Severity="Error" />

            <ScrollViewer
                x:Name="BoardScrollViewer"
                Margin="0,0,0,2"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                SizeChanged="BoardScrollViewer_SizeChanged"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled"
                ZoomMode="Disabled">
                <Grid
                    x:Name="BoardGrid"
                    MinWidth="1264"
                    HorizontalAlignment="Left"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <StackPanel Margin="12,10,12,6" Orientation="Horizontal" Spacing="8">
                                <FontIcon Foreground="#F59E0B" Glyph="&#xE82D;" />
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.IdeasHeader, Mode=OneWay}" />
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <TextBlock x:Uid="PlanningEmptyIdeas" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HasNoIdeas, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                <ListView ItemsSource="{x:Bind ViewModel.Ideas}" ItemTemplate="{StaticResource PlanningCardTemplate}" ItemContainerStyle="{StaticResource PlanningCardListViewItemStyle}" Style="{StaticResource PlanningColumnListStyle}" Tag="Ideas" DragItemsStarting="PlanningList_DragItemsStarting" DragItemsCompleted="PlanningList_DragItemsCompleted" DragOver="PlanningList_DragOver" Drop="PlanningList_Drop" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <StackPanel Margin="12,10,12,6" Orientation="Horizontal" Spacing="8">
                                <FontIcon Foreground="#3B82F6" Glyph="&#xE8FD;" />
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.PlannedHeader, Mode=OneWay}" />
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <TextBlock x:Uid="PlanningEmptyPlanned" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HasNoPlanned, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                <ListView ItemsSource="{x:Bind ViewModel.Planned}" ItemTemplate="{StaticResource PlanningCardTemplate}" ItemContainerStyle="{StaticResource PlanningCardListViewItemStyle}" Style="{StaticResource PlanningColumnListStyle}" Tag="Planned" DragItemsStarting="PlanningList_DragItemsStarting" DragItemsCompleted="PlanningList_DragItemsCompleted" DragOver="PlanningList_DragOver" Drop="PlanningList_Drop" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <StackPanel Margin="12,10,12,6" Orientation="Horizontal" Spacing="8">
                                <ProgressRing Width="16" Height="16" IsActive="True" />
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.InProgressHeader, Mode=OneWay}" />
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <TextBlock x:Uid="PlanningEmptyInProgress" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HasNoInProgress, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                <ListView ItemsSource="{x:Bind ViewModel.InProgress}" ItemTemplate="{StaticResource PlanningCardTemplate}" ItemContainerStyle="{StaticResource PlanningCardListViewItemStyle}" Style="{StaticResource PlanningColumnListStyle}" Tag="InProgress" DragItemsStarting="PlanningList_DragItemsStarting" DragItemsCompleted="PlanningList_DragItemsCompleted" DragOver="PlanningList_DragOver" Drop="PlanningList_Drop" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="3" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <StackPanel Margin="12,10,12,6" Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Foreground="{ThemeResource SystemFillColorSuccessBrush}" Symbol="Accept" />
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.CompletedHeader, Mode=OneWay}" />
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <TextBlock x:Uid="PlanningEmptyCompleted" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HasNoCompleted, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                <ListView ItemsSource="{x:Bind ViewModel.Completed}" ItemTemplate="{StaticResource PlanningCardTemplate}" ItemContainerStyle="{StaticResource PlanningCardListViewItemStyle}" Style="{StaticResource PlanningColumnListStyle}" Tag="Completed" DragItemsStarting="PlanningList_DragItemsStarting" DragItemsCompleted="PlanningList_DragItemsCompleted" DragOver="PlanningList_DragOver" Drop="PlanningList_Drop" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>

            <ProgressRing
                Width="32"
                Height="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
