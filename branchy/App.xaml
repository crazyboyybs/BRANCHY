<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Branchy.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Branchy">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <ImageIconSource
                        x:Key="BranchyTitleBarIconSource"
                        ImageSource="ms-appx:///Assets/ContextMenuIcon.Dark.ico" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <ImageIconSource
                        x:Key="BranchyTitleBarIconSource"
                        ImageSource="ms-appx:///Assets/ContextMenuIcon.Light.ico" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <ImageIconSource
                        x:Key="BranchyTitleBarIconSource"
                        ImageSource="ms-appx:///Assets/ContextMenuIcon.Light.ico" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Resources/DialogMaterials.xaml" />
                <ResourceDictionary Source="ms-appx:///Resources/ToolTipMaterials.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
